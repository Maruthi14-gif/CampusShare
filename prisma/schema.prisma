// ─────────────────────────────────────────────────────────────
//  prisma/schema.prisma
//  Run after pasting:  npx prisma migrate dev --name init
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ───────── Auth.js tables (required by @auth/prisma-adapter) ─────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  rollNo        String?

  accounts Account[]
  sessions Session[]

  items    Item[] // things this user lends
  borrowed Loan[] @relation("borrower")

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────── CampusShare domain ─────────

model Item {
  id          String     @id @default(cuid())
  code        String     @unique // "CS-0147" — printed on the QR tag
  title       String
  category    String
  description String?
  condition   String     @default("good") // good | fair | worn
  imageUrl    String?
  status      ItemStatus @default(AVAILABLE)
  slot        String? // S1..S6 at the lending point

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  loans Loan[]

  createdAt DateTime @default(now())

  @@index([status])
  @@index([category])
}

model Loan {
  id         String     @id @default(cuid())
  itemId     String
  item       Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  borrowerId String
  borrower   User       @relation("borrower", fields: [borrowerId], references: [id], onDelete: Cascade)
  status     LoanStatus @default(RESERVED)

  pickupCode String // 4 digits shown to the borrower
  slot       String?

  dueAt       DateTime
  issuedAt    DateTime?
  collectedAt DateTime?
  returnedAt  DateTime?
  verifiedAt  DateTime?

  logs ConditionLog[]

  createdAt DateTime @default(now())

  @@index([borrowerId])
  @@index([status])
}

// The before/after photo pair — this is the whole trust mechanism.
// Kept in its own table so both photos can be shown side by side.
model ConditionLog {
  id       String @id @default(cuid())
  loanId   String
  loan     Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)
  phase    String // "ISSUE" | "RETURN"
  photoUrl String
  notes    String?

  createdAt DateTime @default(now())
}

enum ItemStatus {
  AVAILABLE
  RESERVED
  ISSUED
  AWAITING_CHECK
}

enum LoanStatus {
  RESERVED
  ISSUED
  COLLECTED
  RETURNED
  VERIFIED
  CANCELLED
}
